# LexFlow — variables d'environnement (Expo charge automatiquement .env)
# Copie ce fichier en `.env` puis renseigne tes valeurs.
# ⚠️ Les variables EXPO_PUBLIC_* sont embarquées dans le bundle client.
#    N'y mets jamais de secret côté serveur.

# --- Coach IA (OpenAI) ---
# Sans clé, le coach/analyse fonctionne en mode fallback hors-ligne.
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# --- Firebase (optionnel : auth + sync Firestore) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
